# Copy to .env.local and fill in. Never commit real values. Variable names only here.

# Site URL, used for auth redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. The URL and anon (publishable) key are safe in the browser; RLS protects the data.
# For local development, `npm run db:start` prints both.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sign-in providers enabled in Supabase Auth (true/false). Email magic links always work.
NEXT_PUBLIC_AUTH_GOOGLE=false
# SSOJet is a Supabase custom OIDC provider with the identifier custom:ssojet.
NEXT_PUBLIC_AUTH_SSOJET=false

# OpenAI (server only). Powers the AI planner and web search. Use a model that supports
# structured outputs and the web_search tool in the Responses API.
OPENAI_API_KEY=
OPENAI_MODEL=

# AI planner and web discovery requests per signed-in user per 24 hours
AI_DAILY_LIMIT=20

# Testing only: point the planner and search at the local stand-ins in e2e/mock-providers.mjs.
# Leave empty to use the real services.
# OPENAI_BASE_URL=http://127.0.0.1:4010/v1
